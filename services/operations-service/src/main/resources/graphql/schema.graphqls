type Query {
    stationStatus(stationId: ID!): StationStatus

    stationStatuses(
        first: Int
        after: String
        status: StationOperationalStatus
    ): StationStatusConnection!
}

enum StationOperationalStatus {
    ONLINE
    OFFLINE
    UNAVAILABLE
}

type StationStatus {
    stationId: ID!
    currentStatus: String!
    lastEventId: ID!
    statusChangedAt: String!
    updatedAt: String!
}