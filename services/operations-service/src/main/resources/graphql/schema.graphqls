type Query {
    stationStatus(stationId: ID!, organizationId: String): StationStatus

    stationStatuses(
        first: Int
        after: String
        status: StationOperationalStatus
        organizationId: String
    ): StationStatusConnection!
}

enum StationOperationalStatus {
    ONLINE
    OFFLINE
    UNAVAILABLE
}

type StationStatus {
    stationId: ID!
    currentStatus: String!
    lastEventId: ID!
    statusChangedAt: String!
    updatedAt: String!
}
