type Query {
    stations(organizationId: ID): [ChargingStation!]!
    station(id: ID!, organizationId: ID): ChargingStation
    stationConnectors(stationId: ID!): [StationConnector!]!

    transactions(organizationId: ID): [ChargingTransaction!]!

    networkTransactions(organizationId: ID): [NetworkTransaction!]!

    networkTransactionPage(
        page: Int!
        size: Int!
        stationId: ID
        transactionId: String
        integrityStatus: TransactionDataStatus
        organizationId: ID
    ): NetworkTransactionPage!

    stationTransactions(
        stationId: ID!
        organizationId: ID
    ): [ChargingTransaction!]!

    transaction(
        stationId: ID!
        transactionId: ID!
        organizationId: ID
    ): ChargingTransaction

    transactionMeterSamples(
        stationId: ID!
        transactionId: ID!
        organizationId: ID
    ): [TransactionMeterSample!]!

    transactionCompleteness(
        stationId: ID!
        transactionId: ID!
        organizationId: ID
    ): TransactionCompleteness!

    # Multi-Tenant & Administrative Queries
    organizations: [Organization!]!
    organization(id: ID!): Organization
    sites(organizationId: ID!): [Site!]!
    organizationMembers(organizationId: ID!): [OrganizationMembership!]!
    administrativeAuditEvents(
        organizationId: ID!
        page: Int
        size: Int
    ): AuditEventPage!
}

type Mutation {
    registerStation(
        input: RegisterStationInput!
    ): ChargingStation!
    mapStation(input: MapStationInput!): ChargingStation!

    createOrganization(input: CreateOrganizationInput!): Organization!
    createSite(input: CreateSiteInput!): Site!
    inviteMember(input: InviteMemberInput!): OrganizationMembership!
    updateMemberRole(organizationId: ID!, userId: String!, role: String!): OrganizationMembership!
    revokeMember(organizationId: ID!, userId: String!): Boolean!

    provisionStationCredential(input: ProvisionCredentialInput!): StationCredentialPayload!
    rotateStationCredential(input: RotateCredentialInput!): StationCredentialPayload!
    revokeStationCredential(stationId: ID!): Boolean!
}

type ChargingStation {
    id: ID!
    name: String!
    status: StationStatus!
    organizationId: String
    siteId: String
}

type Organization {
    id: ID!
    name: String!
    status: String!
    createdAt: String!
    updatedAt: String!
}

type Site {
    id: ID!
    organizationId: ID!
    name: String!
    status: String!
    createdAt: String!
}

type OrganizationMembership {
    id: ID!
    organizationId: ID!
    userId: String!
    userEmail: String!
    role: String!
    status: String!
    createdAt: String!
    updatedAt: String!
}

type StationCredentialPayload {
    credentialId: ID!
    stationId: ID!
    credentialType: String!
    status: String!
    createdAt: String!
}

type AdministrativeAuditEvent {
    id: ID!
    organizationId: ID
    eventType: String!
    actorId: String!
    actorType: String!
    resourceType: String!
    resourceId: String!
    action: String!
    outcome: String!
    correlationId: String
    metadata: String
    createdAt: String!
}

type AuditEventPage {
    content: [AdministrativeAuditEvent!]!
    totalElements: Int!
    totalPages: Int!
    number: Int!
    size: Int!
}

type StationConnector {
    evseId: Int!
    connectorId: Int!
    status: ConnectorStatus!
    statusUpdatedAt: String!
}

type ChargingTransaction {
    stationId: ID!
    transactionId: ID!
    evseId: Int!
    connectorId: Int!
    status: TransactionStatus!
    startedAt: String!
    endedAt: String
    lastSequenceNumber: Int!
}

type NetworkTransaction {
    transaction: ChargingTransaction!
    completeness: TransactionCompleteness!
}

type NetworkTransactionPage {
    content: [NetworkTransaction!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    hasNext: Boolean!
}

type TransactionMeterSample {
    sequenceNumber: Int!
    sampledAt: String!
    value: String!
    measurand: String
    context: String
    phase: String
    location: String
    unit: String
    unitMultiplier: Int!
}

type TransactionCompleteness {
    status: TransactionDataStatus!
    firstSequenceNumber: Int
    lastSequenceNumber: Int!
    missingSequenceNumbers: [Int!]!
}

input RegisterStationInput {
    id: ID!
    name: String!
    organizationId: ID
    siteId: ID
}

input MapStationInput {
    stationId: ID!
    organizationId: ID!
    siteId: ID
}

input CreateOrganizationInput {
    id: ID!
    name: String!
}

input CreateSiteInput {
    id: ID!
    organizationId: ID!
    name: String!
}

input InviteMemberInput {
    organizationId: ID!
    userId: String!
    userEmail: String!
    role: String!
}

input ProvisionCredentialInput {
    stationId: ID!
    password: String!
}

input RotateCredentialInput {
    stationId: ID!
    newPassword: String!
}

enum StationStatus {
    ONLINE
    OFFLINE
}

enum ConnectorStatus {
    AVAILABLE
    OCCUPIED
    RESERVED
    UNAVAILABLE
    FAULTED
}

enum TransactionStatus {
    ACTIVE
    ENDED
}

enum TransactionDataStatus {
    IN_PROGRESS
    COMPLETE
    INCOMPLETE
    UNKNOWN
}
