type Query {
    stations: [ChargingStation!]!
    station(id: ID!): ChargingStation
    stationConnectors(stationId: ID!): [StationConnector!]!

    transactions: [ChargingTransaction!]!

    networkTransactions: [NetworkTransaction!]!

    networkTransactionPage(
        page: Int!
        size: Int!
        stationId: ID
        transactionId: String
    ): NetworkTransactionPage!

    stationTransactions(stationId: ID!): [ChargingTransaction!]!

    transaction(
        stationId: ID!
        transactionId: ID!
    ): ChargingTransaction

    transactionMeterSamples(
        stationId: ID!
        transactionId: ID!
    ): [TransactionMeterSample!]!

    transactionCompleteness(
        stationId: ID!
        transactionId: ID!
    ): TransactionCompleteness!
}

type Mutation {
    registerStation(
        input: RegisterStationInput!
    ): ChargingStation!
}

type ChargingStation {
    id: ID!
    name: String!
    status: StationStatus!
}

type StationConnector {
    evseId: Int!
    connectorId: Int!
    status: ConnectorStatus!
    statusUpdatedAt: String!
}

type ChargingTransaction {
    stationId: ID!
    transactionId: ID!
    evseId: Int!
    connectorId: Int!
    status: TransactionStatus!
    startedAt: String!
    endedAt: String
    lastSequenceNumber: Int!
}

type NetworkTransaction {
    transaction: ChargingTransaction!
    completeness: TransactionCompleteness!
}

type NetworkTransactionPage {
    content: [NetworkTransaction!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    hasNext: Boolean!
}

type TransactionMeterSample {
    sequenceNumber: Int!
    sampledAt: String!
    value: String!
    measurand: String
    context: String
    phase: String
    location: String
    unit: String
    unitMultiplier: Int!
}

type TransactionCompleteness {
    status: TransactionDataStatus!
    firstSequenceNumber: Int
    lastSequenceNumber: Int!
    missingSequenceNumbers: [Int!]!
}

input RegisterStationInput {
    id: ID!
    name: String!
}

enum StationStatus {
    ONLINE
    OFFLINE
}

enum ConnectorStatus {
    AVAILABLE
    OCCUPIED
    RESERVED
    UNAVAILABLE
    FAULTED
}

enum TransactionStatus {
    ACTIVE
    ENDED
}

enum TransactionDataStatus {
    IN_PROGRESS
    COMPLETE
    INCOMPLETE
    UNKNOWN
}