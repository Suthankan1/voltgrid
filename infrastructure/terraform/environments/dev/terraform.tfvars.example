aws_region   = "ap-southeast-1"
environment  = "dev"
project_name = "voltgrid"

# Replace with the issued ACM certificate for the public hostname.
acm_certificate_arn = "arn:aws:acm:ap-southeast-1:123456789012:certificate/00000000-0000-4000-8000-000000000000"

# Set to 0 when the AWS dev backend is not being demonstrated or tested.
services_desired_count = 1